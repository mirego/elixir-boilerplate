    <h1 data-testid={testid_key("home-title")} class="text-3xl font-bold tracking-tight mb-3">
      The stable base for Elixir projects at Mirego.
    </h1>
    <p data-testid={testid_key("home-description")} class="text-base-content/60 text-base leading-relaxed mb-10">This boilerplate is the foundation upon which we build our Elixir applications. It comes with batteries included — Phoenix, GraphQL, database, testing, observability and more.</p>

    <div class="grid grid-cols-2 gap-3 mb-10 sm:grid-cols-3">
      <div class="rounded-box bg-base-200 px-4 py-3">
        <div class="text-xs font-medium text-base-content/50 uppercase tracking-wide mb-1">Web</div>
        <div data-testid={testid_key("stack-web")} class="text-sm font-semibold">Phoenix {Application.spec(:phoenix, :vsn)}</div>
      </div>
      <div class="rounded-box bg-base-200 px-4 py-3">
        <div class="text-xs font-medium text-base-content/50 uppercase tracking-wide mb-1">Language</div>
        <div data-testid={testid_key("stack-language")} class="text-sm font-semibold">Elixir {System.version()}</div>
      </div>
      <div class="rounded-box bg-base-200 px-4 py-3">
        <div class="text-xs font-medium text-base-content/50 uppercase tracking-wide mb-1">GraphQL</div>
        <div data-testid={testid_key("stack-graphql")} class="text-sm font-semibold">Absinthe</div>
      </div>
      <div class="rounded-box bg-base-200 px-4 py-3">
        <div class="text-xs font-medium text-base-content/50 uppercase tracking-wide mb-1">Database</div>
        <div data-testid={testid_key("stack-database")} class="text-sm font-semibold">Ecto + PostgreSQL</div>
      </div>
      <div class="rounded-box bg-base-200 px-4 py-3">
        <div class="text-xs font-medium text-base-content/50 uppercase tracking-wide mb-1">Observability</div>
        <div data-testid={testid_key("stack-observability")} class="text-sm font-semibold">TelemetryUI</div>
      </div>
      <div class="rounded-box bg-base-200 px-4 py-3">
        <div class="text-xs font-medium text-base-content/50 uppercase tracking-wide mb-1">Version</div>
        <div data-testid={testid_key("stack-version")} class="text-sm font-semibold">{Application.spec(:elixir_boilerplate, :vsn)}</div>
      </div>
    </div>

    <div class="flex flex-wrap gap-4 text-sm">
      <a
        data-testid={testid_key("link-github")}
        href="https://github.com/mirego/elixir-boilerplate"
        class="inline-flex items-center gap-2 font-medium hover:underline"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 0C5.37 0 0 5.506 0 12.303c0 5.445 3.435 10.043 8.205 11.674.6.107.825-.262.825-.585 0-.292-.015-1.261-.015-2.291C6 21.67 5.22 20.346 4.98 19.654c-.135-.354-.72-1.446-1.23-1.738-.42-.23-1.02-.8-.015-.815.945-.015 1.62.892 1.845 1.261 1.08 1.86 2.805 1.338 3.495 1.015.105-.8.42-1.338.765-1.645-2.67-.308-5.46-1.37-5.46-6.075 0-1.338.465-2.446 1.23-3.307-.12-.308-.54-1.569.12-3.26 0 0 1.005-.323 3.3 1.26.96-.276 1.98-.415 3-.415s2.04.139 3 .416c2.295-1.6 3.3-1.261 3.3-1.261.66 1.691.24 2.952.12 3.26.765.861 1.23 1.953 1.23 3.307 0 4.721-2.805 5.767-5.475 6.075.435.384.81 1.122.81 2.276 0 1.645-.015 2.968-.015 3.383 0 .323.225.707.825.585a12.047 12.047 0 0 0 5.919-4.489A12.536 12.536 0 0 0 24 12.304C24 5.505 18.63 0 12 0Z" />
        </svg>
        mirego/elixir-boilerplate
      </a>
      <a
        data-testid={testid_key("link-why")}
        href="https://www.mirego.com/en/news/accelerate-the-start-of-new-projects-with-strong-boilerplates"
        class="inline-flex items-center gap-2 font-medium text-base-content/50 hover:text-base-content hover:underline"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
          <path d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Why we built this
      </a>
      <a
        data-testid={testid_key("link-metrics")}
        href="/metrics"
        class="inline-flex items-center gap-2 font-medium text-base-content/50 hover:text-base-content hover:underline"
      >
        <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
          <path d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Metrics dashboard
      </a>
    </div>

    <div class="mt-12 flex justify-end">
      <Layouts.theme_toggle />
    </div>
  </div>
</div>
